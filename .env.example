# SIMPLE OS — variáveis de ambiente (sem valores reais).
# Copie para .env.local e preencha. Nunca versione valores de produção.

# Banco Postgres (banco "crm")
CRM_DATABASE_URL=

# Sessão: segredo longo e aleatório (ex.: openssl rand -base64 32). Obrigatório.
CRM_SESSION_SECRET=
# PIN/senha do usuário administrador. Obrigatório (não há mais valor padrão).
ADMIN_PASSWORD=

# Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Vercel Blob (upload de logos)
BLOB_READ_WRITE_TOKEN=

# IA
OPENAI_API_KEY=

# Instagram (OAuth + métricas)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Assina o "state" do OAuth e cifra os tokens salvos. Obrigatório.
INSTAGRAM_TOKEN_SECRET=

# WhatsApp (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
SOCIOS_GROUP_ID=
CONTATOS_PRIVADOS=
